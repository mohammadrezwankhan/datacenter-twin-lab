diff --git a/languages/python/menhir/Parsing_hacks_python.ml b/languages/python/menhir/Parsing_hacks_python.ml
--- a/languages/python/menhir/Parsing_hacks_python.ml
+++ b/languages/python/menhir/Parsing_hacks_python.ml
@@ -168,10 +168,73 @@
 let rewrite_match_case toks = rewrite 0 [] true toks
 
 (*****************************************************************************)
+(* Soft keyword: type (PEP 695 'type' statement)                             *)
+(*****************************************************************************)
+(* Mirrors rewrite_match_case above: rewrite NAME("type") to TYPE only when
+ * it unambiguously heads a `type X = ...` or `type X[T] = ...`
+ * statement. Calls, assignments and subscriptions using the name `type`
+ * remain ordinary identifiers.
+ *)
+
+(* Authored adaptation: consume exactly one balanced type-parameter bracket
+ * before requiring the assignment token. A mismatched or missing delimiter
+ * does not promote the soft keyword. Normal syntax validation still happens
+ * in Menhir; this lookahead never edits or removes source tokens. *)
+let rec after_type_parameters expected xs =
+  match (expected, skip_trivia xs) with
+  | [], xs -> Some xs
+  | _, T.LPAREN _ :: xs -> after_type_parameters (`Paren :: expected) xs
+  | _, T.LBRACK _ :: xs -> after_type_parameters (`Bracket :: expected) xs
+  | _, T.LBRACE _ :: xs -> after_type_parameters (`Brace :: expected) xs
+  | `Paren :: rest, T.RPAREN _ :: xs -> after_type_parameters rest xs
+  | `Bracket :: rest, T.RBRACK _ :: xs -> after_type_parameters rest xs
+  | `Brace :: rest, T.RBRACE _ :: xs -> after_type_parameters rest xs
+  | _, (T.RPAREN _ | T.RBRACK _ | T.RBRACE _ | T.EOF _) :: _
+  | _, [] ->
+      None
+  | _, _ :: xs -> after_type_parameters expected xs
+
+let starts_type_alias xs =
+  match skip_trivia xs with
+  | T.NAME _ :: xs -> (
+      match skip_trivia xs with
+      | T.EQ _ :: _ -> true
+      | T.LBRACK _ :: xs -> (
+          match after_type_parameters [ `Bracket ] xs with
+          | Some xs -> (
+              match skip_trivia xs with
+              | T.EQ _ :: _ -> true
+              | _ -> false)
+          | None -> false)
+      | _ -> false)
+  | _ -> false
+
+let rec rewrite_type_alias_aux prev_bound = function
+  | [] -> []
+  | (T.NAME ("type", ii) as t) :: xs when prev_bound ->
+      if starts_type_alias xs then T.TYPE ii :: rewrite_type_alias_aux false xs
+      else t :: rewrite_type_alias_aux false xs
+  | t :: xs ->
+      let prev_bound' =
+        if is_trivia t then prev_bound
+        else
+          match t with
+          (* `suite` allows a same-line simple_stmt after the colon (e.g.
+           * `if cond: type Alias = int`), so a colon opens a statement
+           * here too, not just NEWLINE/INDENT/DEDENT/";". *)
+          | T.COLON _ -> true
+          | _ -> is_stmt_boundary t
+      in
+      t :: rewrite_type_alias_aux prev_bound' xs
+
+let rewrite_type_alias toks = rewrite_type_alias_aux true toks
+
+(*****************************************************************************)
 (* Entry point *)
 (*****************************************************************************)
 let fix_tokens toks =
   let toks = rewrite_match_case toks in
+  let toks = rewrite_type_alias toks in
   let rec aux indent xs =
     match xs with
     | [ T.NEWLINE ii; T.EOF _ ] -> add_dedent indent ii xs
